# Dependencies and build output
node_modules/
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
apps/desktop/release/

# Local configuration
.env
.env.*
!.env.example

# Local runtime data and secrets
.local/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.pwbk
# Real credential blobs must never be committed, wherever they appear.
# The SOURCE module at apps/server/src/modules/credentials/ is code, not
# secrets, and is explicitly re-included below.
credentials/
!apps/server/src/modules/credentials/
/backups/
logs/
tmp/imports/

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/

# AI agent working files (personal, not project code)
.workbuddy/
.workbuddy-ai/
.qoder/
.trae/

# Temporary work products
work/
outputs/
/.dev-server*.log
