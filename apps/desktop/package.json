{
  "name": "@workbench/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for Personal Workbench",
  "author": "quexing65",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron . --dev",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
