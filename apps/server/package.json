{
  "name": "@workbench/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build -w @workbench/shared && tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/cli-migrate.ts",
    "import:personal": "tsx src/modules/imports/cli-import.ts personal",
    "import:qoder": "tsx src/modules/imports/cli-import.ts qoder",
    "import:apply": "tsx src/modules/imports/cli-import.ts apply",
    "data:restore": "tsx src/modules/backups/cli-restore.ts",
    "performance:audit": "tsx src/performance/cli-audit.ts",
    "qoder:sanitize": "tsx src/modules/imports/qoder/cli-sanitize.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts apps/server",
    "test:coverage": "vitest run --coverage --root ../.. --config vitest.config.ts apps/server --coverage.include=apps/server/src/**/*.ts"
  },
  "dependencies": {
    "@workbench/shared": "0.1.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.25.76"
  }
}
