{
  "name": "@workbench/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/shared",
    "test:coverage": "vitest run --coverage --root ../.. --config vitest.config.ts packages/shared --coverage.include=packages/shared/src/**/*.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
